{
  "run_name": "e3_convmae_pretrain_rgb_seed0",
  "data": {
    "train_dir": "data/train",
    "test_dir": "data/test",
    "split_file": "splits/seed0_val20.json",
    "image_size": 128,
    "input_mode": "rgb",
    "transform_profile": "standard",
    "augment": true,
    "batch_size": 64,
    "num_workers": 2
  },
  "model": {
    "name": "conv_masked_autoencoder",
    "pretrained": true,
    "patch_size": 16,
    "mask_ratio": 0.5
  },
  "optimizer": {
    "name": "adamw",
    "encoder_lr": 0.00003,
    "decoder_lr": 0.001,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "cosine",
    "min_lr": 0.000001
  },
  "training": {
    "seed": 0,
    "epochs": 30,
    "grad_clip_norm": 5.0,
    "amp": true,
    "deterministic": false
  }
}

